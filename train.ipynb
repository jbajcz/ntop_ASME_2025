   ],
   "source": [
    "# 2. Separate features and targets\n",
    "features = ['X Cell Size', 'YZ Cell Size', 'Velocity Inlet']\n",
    "targets = ['PressureDrop', 'AvgVelocity', 'Surface Area', 'Mass']\n",
    "\n",
    "X = data[features]\n",
    "y = data[targets]\n",
    "\n",
    "# 3. Standardize inputs & outputs using StandardScaler for consistency\n",
    "scaler_X = StandardScaler()\n",
    "X_scaled = scaler_X.fit_transform(X)\n",
    "\n",
    "scaler_y = StandardScaler()\n",
    "y_scaled = scaler_y.fit_transform(y)\n",
    "\n",
    "print(\"Features and targets separated and scaled with StandardScaler.\")\n",
    "print(\"Note: Using StandardScaler for better optimization performance.\")\n",
    "\n",
    "# Verify scaling\n",
    "print(\"\\nScaling verification:\")\n",
    "print(\"X_scaled - Mean:\", np.mean(X_scaled, axis=0).round(6))\n",
    "print(\"X_scaled - Std: \", np.std(X_scaled, axis=0).round(6))\n",
    "print(\"y_scaled - Mean:\", np.mean(y_scaled, axis=0).round(6)) \n",
    "print(\"y_scaled - Std: \", np.std(y_scaled, axis=0).round(6))\n",
    "\n",
    "print(\"\\nOriginal ranges:\")\n",
    "for i, feature in enumerate(features):\n",
    "    print(f\"{feature}: [{X.iloc[:, i].min():.1f}, {X.iloc[:, i].max():.1f}]\")\n",
    "for i, target in enumerate(targets):\n",
    "    print(f\"{target}: [{y.iloc[:, i].min():.1f}, {y.iloc[:, i].max():.1f}]\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fd1085c3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
